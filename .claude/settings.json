{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(forge build *)",
      "Bash(forge test *)",
      "Bash(forge script *)",
      "Bash(anvil *)",
      "Bash(npx graph *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  }
}
